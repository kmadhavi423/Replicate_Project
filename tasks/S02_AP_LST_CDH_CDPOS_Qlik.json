              "action": "REPLACE_COLUMN_VALUE",
              "column": {
                "computation_expression": "ifnull(max(CASE\nWHEN (\n  strftime(\"%m\",ifnull(coalesce(date($AR_M_SOURCE_COLUMN_DATA),date(substr($AR_M_SOURCE_COLUMN_DATA,1,4) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,9,2) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,6,2)),date('1900-01-01')),date('1900-01-01')))='02'\n  and strftime(\"%d\",ifnull(coalesce(date($AR_M_SOURCE_COLUMN_DATA),date(substr($AR_M_SOURCE_COLUMN_DATA,1,4) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,9,2) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,6,2)),date('1900-01-01')),date('1900-01-01')))='29'\n  and\n  (\n    strftime(\"%Y\",ifnull(coalesce(date($AR_M_SOURCE_COLUMN_DATA),date(substr($AR_M_SOURCE_COLUMN_DATA,1,4) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,9,2) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,6,2)),date('1900-01-01')),date('1900-01-01')))%400!=0\n    and\n        (NOT\n          (\n          strftime(\"%Y\",ifnull(coalesce(date($AR_M_SOURCE_COLUMN_DATA),date(substr($AR_M_SOURCE_COLUMN_DATA,1,4) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,9,2) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,6,2)),date('1900-01-01')),date('1900-01-01')))%4=0\n          AND strftime(\"%Y\",ifnull(coalesce(date($AR_M_SOURCE_COLUMN_DATA),date(substr($AR_M_SOURCE_COLUMN_DATA,1,4) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,9,2) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,6,2)),date('1900-01-01')),date('1900-01-01')))%100!=0\n          )\n        )\n  )\n) THEN date('1900-01-01')\nWHEN substr($AR_M_SOURCE_COLUMN_DATA,1,4) = '9999' and substr($AR_M_SOURCE_COLUMN_DATA,6,2) = '12'\n\tthen date('9999-12-31')\nELSE ifnull(\n\tcoalesce(\n\t\tmin(date($AR_M_SOURCE_COLUMN_DATA),date($AR_M_SOURCE_COLUMN_DATA,'+1 months','start of month','-1 days')),\n\t\tmin(date(substr($AR_M_SOURCE_COLUMN_DATA,1,4) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,9,2) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,6,2)),date(substr($AR_M_SOURCE_COLUMN_DATA,1,4) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,9,2) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,6,2),'+1 months','start of month','-1 days')),\n\t\tmin(date(substr($AR_M_SOURCE_COLUMN_DATA,1,4) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,6,2) || '-' || strftime('%d',date(substr($AR_M_SOURCE_COLUMN_DATA,1,4) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,6,2) || '-01','-4 years','+1 months','start of month','-1 days'))),date(substr($AR_M_SOURCE_COLUMN_DATA,1,4) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,6,2) || '-' || strftime('%d',date(substr($AR_M_SOURCE_COLUMN_DATA,1,4) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,6,2) || '-01','-4 years','+1 months','start of month','-1 days')),'+1 months','start of month','-1 days')),\n\t\tmin(date(substr($AR_M_SOURCE_COLUMN_DATA,1,4) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,9,2) || '-' || strftime('%d',date(substr($AR_M_SOURCE_COLUMN_DATA,1,4) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,9,2) || '-01','-4 years','+1 months','start of month','-1 days'))),date(substr($AR_M_SOURCE_COLUMN_DATA,1,4) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,9,2) || '-' || strftime('%d',date(substr($AR_M_SOURCE_COLUMN_DATA,1,4) || '-' || substr($AR_M_SOURCE_COLUMN_DATA,9,2) || '-01','-4 years','+1 months','start of month','-1 days')),'+1 months','start of month','-1 days'))\n\t),\n\tdate('1900-01-01')\n\t)\nEND,date('1900-01-01')),date('1900-01-01'))",
